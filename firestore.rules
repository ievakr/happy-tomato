rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================
    // HELPER FUNCTIONS
    // ========================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if the user is trying to set their own userId
    function isSettingOwnUserId() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
    
    // Check if userId is not being changed
    function userIdNotChanged() {
      return request.resource.data.userId == resource.data.userId;
    }
    
    // User owns an event document
    function ownsEvent() {
      return isAuthenticated() &&
        resource.data.userId is string &&
        resource.data.userId == request.auth.uid;
    }
    
    // ========================================
    // EVENTS COLLECTION
    // ========================================
    
    match /events/{eventId} {
      // Strict ownership — legacy events without userId are admin-only (see functions/migrate-legacy-events.js)
      allow read: if ownsEvent();
      
      // Users can create events only with their own userId
      // The day field can be either a string (date string) or number (timestamp)
      allow create: if isAuthenticated() && 
                      isSettingOwnUserId() &&
                      request.resource.data.keys().hasAll(['userId', 'day']) &&
                      request.resource.data.userId is string &&
                      (request.resource.data.day is string || request.resource.data.day is number);
      
      allow update: if ownsEvent() && userIdNotChanged();
      
      allow delete: if ownsEvent();
    }
    
    // ========================================
    // PLANTS COLLECTION
    // ========================================
    
    match /plants/{plantId} {
      // Users can read their own plants
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Users can create their own plants (category, variety, icon) or legacy (name, icon)
      allow create: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid &&
                      request.resource.data.keys().hasAll(['userId', 'icon']) &&
                      request.resource.data.userId is string &&
                      request.resource.data.icon is string &&
                      ((request.resource.data.keys().hasAll(['category', 'variety']) &&
                        request.resource.data.category is string &&
                        request.resource.data.variety is string) ||
                       (request.resource.data.keys().hasAny(['name']) &&
                        request.resource.data.name is string));
      
      // Users can update their own plants
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Users can delete their own plants
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // ========================================
    // EMAIL PREFERENCES COLLECTION
    // ========================================
    
    // User owns the emailPreferences doc if email or userId matches
    function ownsEmailPrefs(doc) {
      return (doc.userEmail != null && doc.userEmail == request.auth.token.email) ||
             (doc.userId != null && doc.userId == request.auth.uid);
    }
    
    match /emailPreferences/{docId} {
      // Users can read their own preferences (by email or userId)
      allow read: if isAuthenticated() && ownsEmailPrefs(resource.data);
      
      // Users can create their own preferences
      allow create: if isAuthenticated() &&
                       request.resource.data.userEmail is string &&
                       (request.resource.data.userEmail == request.auth.token.email ||
                        request.resource.data.userId == request.auth.uid);
      
      // Users can update their own preferences
      allow update: if isAuthenticated() && ownsEmailPrefs(resource.data);
      
      // Users can delete their own preferences
      allow delete: if isAuthenticated() && ownsEmailPrefs(resource.data);
    }
    
    // ========================================
    // GARDEN PLANS (per user, per year)
    // ========================================
    
    match /gardenPlans/{userId}/years/{year} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // ========================================
    // SAVED TODOS COLLECTION (user preferences)
    // ========================================
    
    match /savedTodos/{userId} {
      // Users can read/write only their own saved todos doc
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // ========================================
    // DEFAULT DENY ALL
    // ========================================
    
    // Deny access to all other collections/documents by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

