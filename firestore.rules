rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================
    // HELPER FUNCTIONS
    // ========================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isSettingOwnUserId() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
    
    function userIdNotChanged() {
      return request.resource.data.userId == resource.data.userId;
    }
    
    function ownsEvent() {
      return isAuthenticated() &&
        resource.data.userId is string &&
        resource.data.userId == request.auth.uid;
    }
    
    function ownsPlant() {
      return isAuthenticated() &&
        resource.data.userId is string &&
        resource.data.userId == request.auth.uid;
    }
    
    // emailPreferences: read/delete — email must match; userId must match when present (legacy docs may omit userId)
    function canReadEmailPrefs(doc) {
      return isAuthenticated() &&
        doc.userEmail is string &&
        doc.userEmail == request.auth.token.email &&
        (!('userId' in doc) || (doc.userId is string && doc.userId == request.auth.uid));
    }
    
    // emailPreferences: new docs must bind both email and uid
    function emailPrefsIdentityValid(doc) {
      return doc.userEmail is string &&
        doc.userEmail == request.auth.token.email &&
        doc.userId is string &&
        doc.userId == request.auth.uid;
    }
    
    function emailPrefsEmailUnchanged() {
      return request.resource.data.userEmail is string &&
        request.resource.data.userEmail == resource.data.userEmail;
    }
    
    function emailPrefsUserIdUnchanged() {
      return !('userId' in resource.data)
        ? (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid)
        : request.resource.data.userId == resource.data.userId;
    }
    
    // ========================================
    // EVENTS COLLECTION
    // ========================================
    
    match /events/{eventId} {
      allow read: if ownsEvent();
      
      allow create: if isAuthenticated() && 
                      isSettingOwnUserId() &&
                      request.resource.data.keys().hasAll(['userId', 'day']) &&
                      request.resource.data.userId is string &&
                      (request.resource.data.day is string || request.resource.data.day is number);
      
      allow update: if ownsEvent() && userIdNotChanged();
      
      allow delete: if ownsEvent();
    }
    
    // ========================================
    // PLANTS COLLECTION
    // ========================================
    
    match /plants/{plantId} {
      allow read: if ownsPlant();
      
      allow create: if isAuthenticated() && 
                      isSettingOwnUserId() &&
                      request.resource.data.keys().hasAll(['userId', 'icon']) &&
                      request.resource.data.userId is string &&
                      request.resource.data.icon is string &&
                      ((request.resource.data.keys().hasAll(['category', 'variety']) &&
                        request.resource.data.category is string &&
                        request.resource.data.variety is string) ||
                       (request.resource.data.keys().hasAny(['name']) &&
                        request.resource.data.name is string));
      
      allow update: if ownsPlant() && userIdNotChanged();
      
      allow delete: if ownsPlant();
    }
    
    // ========================================
    // EMAIL PREFERENCES COLLECTION
    // ========================================
    
    match /emailPreferences/{docId} {
      allow read: if canReadEmailPrefs(resource.data);
      
      allow create: if isAuthenticated() &&
                       emailPrefsIdentityValid(request.resource.data);
      
      allow update: if isAuthenticated() &&
                       canReadEmailPrefs(resource.data) &&
                       emailPrefsEmailUnchanged() &&
                       emailPrefsUserIdUnchanged();
      
      allow delete: if canReadEmailPrefs(resource.data);
    }
    
    // ========================================
    // GARDEN PLANS (per user, per year)
    // ========================================
    
    match /gardenPlans/{userId}/years/{year} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // ========================================
    // SAVED TODOS COLLECTION (user preferences)
    // ========================================
    
    match /savedTodos/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // ========================================
    // DEFAULT DENY ALL
    // ========================================
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
