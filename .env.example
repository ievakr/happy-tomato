# ==============================================
# Happy Tomato - Environment Variables
# ==============================================
# This file contains all environment variables needed for the application.
# Copy this file to .env and fill in your actual values.
# 
# IMPORTANT: Never commit .env files to version control!
# ==============================================

# ----------------------------------------------
# Firebase Configuration (Frontend)
# ----------------------------------------------
# Get these values from your Firebase Console:
# https://console.firebase.google.com/ > Project Settings > Your apps > Config

REACT_APP_FIREBASE_API_KEY=your-firebase-api-key-here
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
REACT_APP_FIREBASE_APP_ID=your-app-id

# Optional: Firebase Analytics Measurement ID
REACT_APP_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Web push (FCM) — required for browser push reminders
# Firebase Console → Project settings → Cloud Messaging → Web Push certificates → Generate key pair
REACT_APP_FIREBASE_VAPID_KEY=your-web-push-public-key

# Optional: App Check (bot/abuse protection for Auth, Firestore, Functions)
# Firebase Console → Build → App Check → register this web app → reCAPTCHA v3 → copy site key
# Leave unset to keep App Check disabled (e.g. before you've enabled it for this project).
REACT_APP_RECAPTCHA_SITE_KEY=your-recaptcha-v3-site-key


# ----------------------------------------------
# Firebase Functions (Backend)
# ----------------------------------------------
# Scheduled TODO reminders use Firebase Cloud Messaging (FCM). No SendGrid setup is required.
# Reminder schedules use Europe/Vilnius in functions/index.js (adjust if needed).


# ----------------------------------------------
# Development Notes
# ----------------------------------------------
# 1. After creating your .env file, restart your development server
# 2. The app validates required Firebase variables on startup
# 3. Run `npm start` / `npm run build` so scripts/write-firebase-sw-config.js generates public/__firebase-sw-config.js for the service worker
# 4. Deploy Cloud Functions after changing push handlers (sendTodoReminderPush, sendWeeklySummaryPush, scheduled jobs)
#
# Mobile (Capacitor): add GoogleService-Info.plist → ios/App/App/ and google-services.json → android/app/
# (when you add Android). Enable Push Notifications in Xcode; upload APNs key to Firebase. VAPID is web-only.
