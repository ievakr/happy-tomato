# ==============================================
# Happy Tomato - Environment Variables
# ==============================================
# This file contains all environment variables needed for the application.
# Copy this file to .env and fill in your actual values.
# 
# IMPORTANT: Never commit .env files to version control!
# ==============================================

# ----------------------------------------------
# Firebase Configuration (Frontend)
# ----------------------------------------------
# Get these values from your Firebase Console:
# https://console.firebase.google.com/ > Project Settings > Your apps > Config

REACT_APP_FIREBASE_API_KEY=your-firebase-api-key-here
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
REACT_APP_FIREBASE_APP_ID=your-app-id

# Optional: Firebase Analytics Measurement ID
REACT_APP_FIREBASE_MEASUREMENT_ID=your-measurement-id


# ----------------------------------------------
# Firebase Functions Configuration (Backend)
# ----------------------------------------------
# Note: Firebase Functions use Firebase config, not .env files.
# Set these using the Firebase CLI:
#
# firebase functions:config:set sendgrid.api_key="your-sendgrid-api-key"
# firebase functions:config:set sendgrid.from_email="your-verified-sender@example.com"
#
# Required values:
# - sendgrid.api_key: Your SendGrid API key for sending emails
# - sendgrid.from_email: Verified sender email address in SendGrid


# ----------------------------------------------
# Development Notes
# ----------------------------------------------
# 1. After creating your .env file, restart your development server
# 2. The app validates required Firebase variables on startup
# 3. SendGrid configuration is only needed for Firebase Functions
# 4. Email reminders run on a schedule in production (Europe/Vilnius timezone)
